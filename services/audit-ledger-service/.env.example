ENVIRONMENT=production
LEDGER_AUTO_MIGRATE=false
# PostgreSQL SQLAlchemy connection URL for the durable ledger database.
LEDGER_DATABASE_URL=
# Render can derive LEDGER_DATABASE_URL from these two values.
MIGRATION_DATABASE_URL=
LEDGER_DATABASE_PASSWORD=
# Generate a random secret of at least 32 bytes. Share only with trusted backend services.
SERVICE_AUTH_TOKEN=
