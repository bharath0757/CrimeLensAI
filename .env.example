# ============================================================
# CrimeLensAI - Environment Configuration
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=crimelens
POSTGRES_PASSWORD=crimelens_dev_password
POSTGRES_DB=crimelens
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://crimelens:crimelens_dev_password@postgres:5432/crimelens

# ---- Neo4j ----
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_password

# ---- Service URLs (internal Docker network) ----
EXTRACTION_SERVICE_URL=http://extraction:8001
GRAPH_SERVICE_URL=http://graph:8002
LEDGER_SERVICE_URL=http://ledger:8003
API_SERVICE_URL=http://api:8000
INGESTION_SERVICE_URL=http://ingestion:8004

# ---- JWT / Auth ----
JWT_SECRET_KEY=change-this-to-a-real-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000
