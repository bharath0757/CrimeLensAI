# Copy to .env. Keep real values out of Git.
# Generate URL-safe service secrets, for example: openssl rand -hex 32
POSTGRES_USER=crimelens_owner
POSTGRES_PASSWORD=
POSTGRES_DB=crimelens
API_DATABASE_PASSWORD=
LEDGER_DATABASE_PASSWORD=
NEO4J_PASSWORD=
SECRET_KEY=
SERVICE_AUTH_TOKEN=

# The first administrator is created automatically. This value is stored as a bcrypt hash.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Synthetic records and known demo accounts stay off unless both switches are true.
SEED_SYNTHETIC=false
ALLOW_DEMO_SEED=false

# Local ports bind only to this address. Use a reverse proxy for remote access.
BIND_ADDRESS=127.0.0.1
API_PORT=8000
WEB_PORT=5173

# Use [] for same-origin Docker access. For Vercel, use a JSON list containing its URL.
ALLOWED_ORIGINS=[]
VITE_API_BASE_URL=
