# Public API origin, without /api/v1 or a trailing slash. Never put secrets here.
# Leave empty only when a same-origin /api reverse proxy is configured.
VITE_API_BASE_URL=
# Local Vite development only: API origin when using the same-origin proxy.
API_PROXY_TARGET=

# Show public quick-fill demo accounts. Leave false for production unless explicitly required.
VITE_ENABLE_DEMO_ACCOUNTS=false
